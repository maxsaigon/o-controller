{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "O-Control",
  "version": "0.1.0",
  "identifier": "com.maxsaigon.o-control",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "O-Control",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; img-src 'self' http://localhost:* http://127.0.0.1:* https:* data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": {
      "resources/o-control-service-bun": "o-control-service-bun",
      "resources/o-control-service.cjs": "o-control-service.cjs"
    },
    "externalBin": ["binaries/o-control-service"]
  }
}
